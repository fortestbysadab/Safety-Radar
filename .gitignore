frontend/android/*.iml
frontend/android/.idea/
frontend/android/.cxx/
frontend/android/captures/
frontend/android/app/.cxx/
frontend/android/app/src/main/assets/public/
frontend/ios/
*.apk
*.aab
*.keystore

