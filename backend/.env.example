# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored.

NODE_ENV=development
PORT=10000

# PostgreSQL (Supabase or Neon) — must have PostGIS enabled
DATABASE_URL=postgres://postgres:password@db.xxx.supabase.co:5432/postgres
DATABASE_SSL=true

# Supabase project (used to verify Google OAuth JWTs)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # server-only secret!

# Long random string used for HMAC-SHA256 anonymization
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HMAC_SECRET=replace-me-with-64-random-hex-chars-xxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated allowed origins (or *)
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Anti-abuse tuning (match spec §7)
GEOFENCE_MAX_METERS=100
RATE_LIMIT_MAX=3
RATE_LIMIT_WINDOW_MINUTES=30
